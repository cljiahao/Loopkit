NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production only.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
MERQO_METRICS_SECRET=
# Separate from MERQO_METRICS_SECRET; guards the /api/merqo/vendor-provision write endpoint.
MERQO_PROVISION_SECRET=

# Telegram reward-redemption alerts (optional — leave all three blank to
# ship without the feature). Bot token from @BotFather; bot username
# (no leading @) builds the https://t.me/<username>?start=<token> deep
# link; webhook secret is a self-chosen random string, NOT the bot token
# — configured on Telegram's side via a one-time `setWebhook` call (see
# docs/DEPLOY.md's "Telegram bot setup"), verified against the
# X-Telegram-Bot-Api-Secret-Token header on every webhook POST.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Customer Telegram connect (optional — leave both blank to ship without the
# feature). redeemAction posts to merqo's notify-customer endpoint in its
# `phone` lookup mode, reusing a standing Telegram connection the customer
# already made via qkit — loopkit never mints its own connect token. Values
# must match merqo's own env records for this kit (kit -> merqo direction,
# unlike MERQO_METRICS_SECRET/MERQO_PROVISION_SECRET above).
MERQO_BASE_URL=
MERQO_CUSTOMER_SECRET=

# Google OAuth (read by the Supabase CLI when running `supabase start`, NOT by Next).
# Create an OAuth 2.0 Web client in Google Cloud Console; authorized redirect URI:
#   local: http://127.0.0.1:54321/auth/v1/callback
#   prod:  https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
